# Optional server-managed SMTP profile. Keep actual values outside Git.
# Select "server configuration" in /cms#mail to use this profile.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-school@gmail.com
MAIL_PASSWORD="YOUR_16_CHARACTER_APP_PASSWORD"
MAIL_FROM_ADDRESS=your-school@gmail.com
MAIL_FROM_NAME="School name"
# Alternative implicit TLS: MAIL_SCHEME=smtps and MAIL_PORT=465
# Never put an actual password in this example or a public folder.
