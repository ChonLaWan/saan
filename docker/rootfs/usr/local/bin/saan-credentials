#!/bin/bash
# Show the passwords generated at install:   docker compose exec saan saan-credentials
# (--write: build the file; used once by saan-entrypoint). The file lives only in the secrets volume (mode 0600), never in an image or git.
set -euo pipefail
SEC=/srv/saan-secrets; F=$SEC/credentials.txt
APP_PORT=${SAAN_APP_PORT:-8443}; WWW_PORT=${SAAN_WWW_PORT:-9443}; HOSTS=${SAAN_HOSTS:-localhost}; HOSTS=${HOSTS// /}; FIRST=${HOSTS%%,*}
if [ "${1:-}" = "--write" ]; then
    umask 077
    R=$SEC/install-result.json
    { echo "Saan (สาน) - บัญชีและรหัสผ่านที่สร้างตอนติดตั้ง ($(date '+%F %T'))"
      echo "เก็บไฟล์นี้เป็นความลับ ผู้ดูแลระบบต้องเปลี่ยนรหัสผ่านเมื่อเข้าระบบครั้งแรก (บัญชีทดลองไม่ต้องเปลี่ยน)"
      echo
      echo "ระบบภายใน (บุคลากร)    https://$FIRST:$APP_PORT/login"
      echo "เว็บไซต์โรงเรียน         https://$FIRST:$WWW_PORT/"
      echo "หลังบ้านเว็บไซต์          https://$FIRST:$APP_PORT/cms"
      echo
      echo "[ผู้ดูแลระบบ]"
      if [ -f "$SEC/admin-initial" ]; then echo "  อีเมล:    $(sed -n 1p "$SEC/admin-initial")"; echo "  รหัสผ่าน: $(sed -n 2p "$SEC/admin-initial")"; fi
      echo
      echo "[ฐานข้อมูล MariaDB] (ใช้เมื่อสำรองหรือแก้ปัญหาเท่านั้น)"
      echo "  root:        $(cat "$SEC/db-root-password")"
      if [ -s "$R" ]; then
          for side in internal public; do
              echo "  $side: ฐาน $(jq -r ".creds.$side.db_name" "$R")  ผู้ใช้ $(jq -r ".creds.$side.db_user" "$R")  รหัสผ่าน $(jq -r ".creds.$side.db_password" "$R")"
          done
      fi
      if [ -s "$SEC/trial-accounts.txt" ]; then echo; echo "[บัญชีทดลองของโรงเรียนสมมติ]"; sed -e 's/\x1b\[[0-9;]*m//g' "$SEC/trial-accounts.txt"; fi
      echo
      echo "ใบรับรอง CA สำหรับให้เครื่องอื่นเชื่อถือ HTTPS: docker compose cp saan:/srv/saan/tls/ca.crt ./saan-ca.crt"
    } > "$F.tmp"
    chmod 0600 "$F.tmp"; mv "$F.tmp" "$F"
    exit 0
fi
[ -s "$F" ] || { echo "[saan] [WARN] ยังไม่มีไฟล์รหัสผ่าน (ติดตั้งยังไม่เสร็จ ดู docker compose logs -f saan)"; exit 1; }
cat "$F"
