# Saan container settings. Copy to .env and edit. No passwords here: every password is generated at the first start
# and shown by:  docker compose exec saan saan-credentials

# Addresses people type to reach this machine, comma separated, the first one is used in links.
# Examples: 192.168.1.20   or   saan.school.local,192.168.1.20   or   localhost (this computer only)
SAAN_HOSTS=localhost

# HTTPS ports: internal system (staff, students, guardians) and public school website
SAAN_APP_PORT=8443
SAAN_WWW_PORT=9443

# Starting data: blank (real school, empty) | demo (sample website) | full (fictional school, every role, for trials only)
SAAN_DATA=blank

SAAN_SCHOOL_NAME=โรงเรียนตัวอย่าง
SAAN_ADMIN_NAME=ผู้ดูแลระบบ
SAAN_ADMIN_EMAIL=admin@school.example

# Image version (the release packages baked into the image)
SAAN_VERSION=0.9.0

# Advanced: listen address of the published ports, and the private network between the two containers
# (change the subnet only if 10.89.47.0/24 is already used on your network)
SAAN_BIND=0.0.0.0
SAAN_SUBNET=10.89.47.0/24
SAAN_APP_IP=10.89.47.10
SAAN_DB_IP=10.89.47.11
