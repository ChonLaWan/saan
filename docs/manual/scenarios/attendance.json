{
  "module": "attendance",
  "title": "เช็คชื่อและรายงานการมาเรียน",
  "area": "งานวิชาการและงานนักเรียน",
  "purpose": "ครูบันทึกการมาเรียนรายห้องรายวันบนหน้าจอเดียว โดยกดเฉพาะนักเรียนที่ขาด สาย ลา หรือป่วย นักเรียนที่เหลือถือว่ามาเรียน เมื่อกดบันทึกแล้วระบบเก็บชื่อผู้บันทึกและเวลา เก็บประวัติเมื่อมีการแก้สถานะ ผู้ปกครองและนักเรียนเห็นผลในพอร์ทัลของตน และครูหรือผู้บริหารเปิดรายงานรายเดือน สรุปรายวัน และประวัติรายบุคคล พร้อมส่งออกเป็นไฟล์ CSV ได้",
  "roles": [
    "ครูประจำชั้น (เช็คชื่อและดูรายงานของห้องตนเอง)",
    "ครูผู้สอน (ห้องที่ได้รับมอบหมาย)",
    "ผู้อำนวยการ (ดูสรุปรายวันทุกห้อง)",
    "ผู้ปกครองและนักเรียน (ดูผลในพอร์ทัล)"
  ],
  "menu": [
    "เมนูด้านซ้าย \"งานโรงเรียน\" > \"เช็คชื่อ\" (/work#attendance)",
    "เมนูด้านซ้าย \"งานโรงเรียน\" > \"รายงานการมาเรียน\" (/work#attendance-report)"
  ],
  "prerequisites": [
    {
      "module": "academic",
      "text": "ต้องตั้งค่าปีการศึกษา ภาคเรียน ห้องเรียน และมอบหมายครูประจำชั้นหรือครูผู้สอนของห้อง"
    },
    {
      "module": "registry",
      "text": "ต้องมีรายชื่อนักเรียนอยู่ในห้อง"
    },
    {
      "module": "guardian-portal",
      "text": "ผู้ปกครองต้องมีบัญชีและผูกกับนักเรียนจึงจะเห็นผลในพอร์ทัลผู้ปกครอง"
    }
  ],
  "vars": {
    "student": "เด็กชายกวิน ธารใส",
    "student_short": "กวิน ธารใส",
    "classroom": "ม.1/1",
    "note_absent": "{{marker}} ขาด",
    "note_leave": "{{marker}} ลา"
  },
  "workflows": [
    {
      "id": "take-attendance",
      "title": "เช็คชื่อห้องเรียนของวันที่ต้องการ และบันทึกนักเรียนที่ขาด",
      "intro": "หน้านี้ใช้ได้ทั้งการเช็คชื่อครั้งแรกของวัน และการเปิดวันที่เคยเช็คแล้วเพื่อดูหรือแก้ไข ระบบเลือกวันที่เป็นวันนี้ให้ก่อน หากวันนี้เป็นวันเสาร์-อาทิตย์หรือวันหยุด ระบบไม่เปิดให้เช็คชื่อ ให้เลือกวันทำการแทน",
      "role": "homeroom",
      "start": "/work",
      "core": true,
      "steps": [
        {
          "do": "click",
          "target": {
            "role": "link",
            "name": "เช็คชื่อ",
            "exact": true,
            "within": {
              "role": "navigation",
              "name": "ระบบงานโรงเรียน"
            }
          },
          "say": "เลือกเมนู \"เช็คชื่อ\" ที่แถบเมนูด้านซ้าย",
          "shot": true,
          "wait_after": {
            "css": "section.att .att-pick"
          }
        },
        {
          "do": "fill",
          "target": {
            "label": "วันที่",
            "within": {
              "css": "section.att"
            }
          },
          "value": "{{last_weekday}}",
          "say": "เลือกวันที่ที่ต้องการเช็คชื่อในช่อง \"วันที่\" ช่องนี้เลือกได้เฉพาะวันนี้และวันที่ผ่านมาแล้ว และต้องเป็นวันจันทร์ถึงวันศุกร์ที่ไม่ใช่วันหยุด",
          "shot": true,
          "crop": "panel",
          "wait_after": {
            "role": "button",
            "name": "{{student}} สถานะ"
          }
        },
        {
          "do": "select",
          "target": {
            "label": "ห้องเรียน",
            "within": {
              "css": "section.att"
            }
          },
          "label": "ม.1/1 (ประจำชั้น)",
          "say": "ตรวจว่าช่อง \"ห้องเรียน\" เป็น \"ม.1/1 (ประจำชั้น)\" ระบบเลือกห้องประจำชั้นของครูให้เอง ครูที่สอนห้องอื่นเปลี่ยนห้องได้ที่ช่องนี้",
          "shot": true,
          "crop": "panel",
          "wait_after": {
            "role": "button",
            "name": "{{student}} สถานะ"
          }
        },
        {
          "do": "expect",
          "that": {
            "visible": {
              "role": "button",
              "name": "{{student}} สถานะ มา",
              "within": {
                "css": "section.att"
              }
            }
          },
          "comment": "precondition: the student starts as present, otherwise an earlier run left dirty data"
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "{{student}} สถานะ",
            "within": {
              "css": "section.att"
            }
          },
          "say": "แตะที่แถวของ \"{{student}}\" 1 ครั้ง สถานะเปลี่ยนจาก \"มา\" เป็น \"ขาด\" (แตะซ้ำจะวนเป็น สาย ลา ป่วย แล้วกลับเป็น มา)",
          "shot": true,
          "crop": "tight",
          "highlight": {
            "css": "li.att-row",
            "has_text": "{{student}}"
          }
        },
        {
          "do": "fill",
          "target": {
            "label": "หมายเหตุของ {{student}}",
            "within": {
              "css": "section.att"
            }
          },
          "value": "{{note_absent}}",
          "say": "พิมพ์เหตุผลหรือข้อสังเกตในช่อง \"หมายเหตุ (ไม่บังคับ)\" ช่องนี้จะปรากฏเมื่อสถานะไม่ใช่ \"มา\"",
          "shot": true,
          "crop": "tight"
        },
        {
          "do": "check",
          "target": {
            "label": "เช็คชื่อห้องนี้แล้ว",
            "within": {
              "css": "section.att"
            }
          },
          "say": "ตรวจว่าช่อง \"เช็คชื่อห้องนี้แล้ว (คนที่ไม่ได้ระบุถือว่ามาเรียน)\" มีเครื่องหมายถูก ช่องนี้เป็นการยืนยันว่าครูเช็คชื่อห้องนี้ในวันนั้นแล้ว",
          "shot": true,
          "crop": "tight"
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "บันทึก",
            "within": {
              "css": "section.att"
            }
          },
          "say": "กดปุ่ม \"บันทึก\" ระบบแสดงข้อความ \"บันทึกแล้ว\" ที่ด้านล่างของหน้าจอชั่วครู่ (กรอบสีแดงในภาพ)",
          "shot": true,
          "crop": "viewport",
          "highlight": {
            "id": "toast"
          },
          "expect_response": {
            "url_contains": "/api/attendance/sheet",
            "method": "POST",
            "status": 200
          },
          "wait_after": {
            "id": "toast"
          }
        },
        {
          "do": "expect",
          "that": [
            {
              "visible": {
                "css": ".att-chip.att-absent",
                "within": {
                  "css": "li.att-row",
                  "has_text": "{{student}}"
                }
              }
            },
            {
              "value": "{{note_absent}}",
              "of": {
                "label": "หมายเหตุของ {{student}}"
              }
            }
          ]
        }
      ],
      "expected": "แถวของนักเรียนแสดงสถานะ \"ขาด\" พร้อมหมายเหตุ และมีข้อความ \"บันทึกโดย\" ตามด้วยชื่อครูและเวลาที่บันทึก",
      "verify": [
        {
          "title": "เปิดหน้าเช็คชื่อใหม่ แล้วข้อมูลที่บันทึกต้องยังอยู่",
          "steps": [
            {
              "do": "reload"
            },
            {
              "do": "fill",
              "target": {
                "label": "วันที่",
                "within": {
                  "css": "section.att"
                }
              },
              "value": "{{last_weekday}}",
              "wait_after": {
                "role": "button",
                "name": "{{student}} สถานะ"
              }
            },
            {
              "do": "expect",
              "that": [
                {
                  "visible": {
                    "css": ".att-chip.att-absent",
                    "within": {
                      "css": "li.att-row",
                      "has_text": "{{student}}"
                    }
                  }
                },
                {
                  "value": "{{note_absent}}",
                  "of": {
                    "label": "หมายเหตุของ {{student}}"
                  }
                },
                {
                  "text": "บันทึกโดย",
                  "in": {
                    "css": "li.att-row",
                    "has_text": "{{student}}"
                  }
                }
              ],
              "say": "เปิดหน้า \"เช็คชื่อ\" ใหม่และเลือกวันที่เดิม ระบบแสดงสถานะ \"ขาด\" และหมายเหตุที่บันทึกไว้ พร้อมชื่อผู้บันทึก",
              "shot": true,
              "crop": "tight",
              "highlight": {
                "css": "li.att-row",
                "has_text": "{{student}}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "correct-entry",
      "title": "แก้สถานะที่บันทึกไว้แล้ว (ขาดเป็นลา)",
      "intro": "ครูแก้สถานะของวันที่เคยบันทึกได้ภายในจำนวนวันที่ผู้ดูแลระบบกำหนด (ค่าเริ่มต้น 3 วัน) เกินกำหนดนี้ระบบให้กรอกเหตุผลการบันทึกย้อนหลัง ระบบเก็บประวัติการแก้ไขทุกครั้ง",
      "role": "homeroom",
      "start": "/work",
      "depends_on": [
        "take-attendance"
      ],
      "steps": [
        {
          "do": "click",
          "target": {
            "role": "link",
            "name": "เช็คชื่อ",
            "exact": true,
            "within": {
              "role": "navigation",
              "name": "ระบบงานโรงเรียน"
            }
          },
          "say": "เลือกเมนู \"เช็คชื่อ\" ที่แถบเมนูด้านซ้าย",
          "wait_after": {
            "css": "section.att .att-pick"
          }
        },
        {
          "do": "fill",
          "target": {
            "label": "วันที่",
            "within": {
              "css": "section.att"
            }
          },
          "value": "{{last_weekday}}",
          "say": "เลือกวันที่ที่ต้องการแก้ไขในช่อง \"วันที่\"",
          "shot": true,
          "crop": "panel",
          "wait_after": {
            "role": "button",
            "name": "{{student}} สถานะ"
          }
        },
        {
          "do": "expect",
          "that": {
            "visible": {
              "css": ".att-chip.att-absent",
              "within": {
                "css": "li.att-row",
                "has_text": "{{student}}"
              }
            }
          },
          "say": "แถวของ \"{{student}}\" แสดงสถานะ \"ขาด\" ที่บันทึกไว้ก่อนหน้า",
          "shot": true,
          "crop": "tight",
          "highlight": {
            "css": "li.att-row",
            "has_text": "{{student}}"
          }
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "{{student}} สถานะ",
            "within": {
              "css": "section.att"
            }
          }
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "{{student}} สถานะ",
            "within": {
              "css": "section.att"
            }
          },
          "say": "แตะที่แถวของ \"{{student}}\" อีก 2 ครั้ง สถานะเปลี่ยนจาก \"ขาด\" เป็น \"สาย\" แล้วเป็น \"ลา\"",
          "shot": true,
          "crop": "tight",
          "highlight": {
            "css": "li.att-row",
            "has_text": "{{student}}"
          }
        },
        {
          "do": "fill",
          "target": {
            "label": "หมายเหตุของ {{student}}",
            "within": {
              "css": "section.att"
            }
          },
          "value": "{{note_leave}}",
          "say": "แก้ข้อความในช่อง \"หมายเหตุ (ไม่บังคับ)\" ให้ตรงกับเหตุผลใหม่",
          "shot": true,
          "crop": "tight"
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "บันทึก",
            "within": {
              "css": "section.att"
            }
          },
          "say": "กดปุ่ม \"บันทึก\"",
          "shot": true,
          "crop": "viewport",
          "highlight": {
            "id": "toast"
          },
          "expect_response": {
            "url_contains": "/api/attendance/sheet",
            "method": "POST",
            "status": 200
          },
          "wait_after": {
            "id": "toast"
          }
        },
        {
          "do": "expect",
          "that": {
            "visible": {
              "css": ".att-chip.att-leave",
              "within": {
                "css": "li.att-row",
                "has_text": "{{student}}"
              }
            }
          }
        }
      ],
      "expected": "แถวของนักเรียนแสดงสถานะ \"ลา\" และหมายเหตุใหม่ ส่วนประวัติการแก้ไขดูได้ที่หน้าประวัติรายบุคคล",
      "verify": [
        {
          "title": "เปิดหน้าเช็คชื่อใหม่ สถานะ \"ลา\" และหมายเหตุใหม่ต้องยังอยู่",
          "steps": [
            {
              "do": "reload"
            },
            {
              "do": "fill",
              "target": {
                "label": "วันที่",
                "within": {
                  "css": "section.att"
                }
              },
              "value": "{{last_weekday}}",
              "wait_after": {
                "role": "button",
                "name": "{{student}} สถานะ"
              }
            },
            {
              "do": "expect",
              "that": [
                {
                  "visible": {
                    "css": ".att-chip.att-leave",
                    "within": {
                      "css": "li.att-row",
                      "has_text": "{{student}}"
                    }
                  }
                },
                {
                  "value": "{{note_leave}}",
                  "of": {
                    "label": "หมายเหตุของ {{student}}"
                  }
                }
              ],
              "say": "เปิดหน้า \"เช็คชื่อ\" ใหม่และเลือกวันที่เดิม แถวของนักเรียนแสดงสถานะ \"ลา\" และหมายเหตุที่แก้ไว้",
              "shot": true,
              "crop": "tight",
              "highlight": {
                "css": "li.att-row",
                "has_text": "{{student}}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "guardian-sees-absence",
      "title": "ผู้ปกครองดูวันที่บุตรหลานไม่ได้มาเรียนในพอร์ทัลผู้ปกครอง",
      "intro": "ผู้ปกครองเข้าระบบที่หน้า \"พอร์ทัลผู้ปกครอง\" ของโรงเรียน (ที่อยู่ลงท้ายด้วย /guardian) แท็บ \"การมาเรียน\" แสดงเฉพาะวันที่ไม่ได้มาเรียนตามปกติ คือ ขาด สาย ลา ป่วย ของเดือนที่เลือก",
      "role": "anonymous",
      "start": "/guardian",
      "depends_on": [
        "correct-entry"
      ],
      "steps": [
        {
          "do": "fill",
          "target": {
            "label": "อีเมลหรือชื่อผู้ใช้"
          },
          "value": "{{secret:guardian1.login}}",
          "say": "พิมพ์อีเมลหรือชื่อผู้ใช้ของผู้ปกครองในช่อง \"อีเมลหรือชื่อผู้ใช้\"",
          "shot": true,
          "crop": "viewport"
        },
        {
          "do": "fill",
          "target": {
            "label": "รหัสผ่าน"
          },
          "value": "{{secret:guardian1.password}}",
          "secret": true,
          "say": "พิมพ์รหัสผ่านในช่อง \"รหัสผ่าน\" (ภาพนี้ปิดรหัสผ่านไว้)",
          "shot": true,
          "crop": "panel"
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "เข้าสู่ระบบ"
          },
          "say": "กดปุ่ม \"เข้าสู่ระบบ\"",
          "shot": true,
          "wait_after": {
            "role": "heading",
            "name": "{{student_short}}"
          }
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "การมาเรียน",
            "exact": true
          },
          "say": "เลือกแท็บ \"การมาเรียน\" (ระบบเลือกให้เองเมื่อเปิดหน้านี้)",
          "shot": true,
          "crop": "tight"
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "เดือนก่อน"
          },
          "when": {
            "equals": [
              "{{month_differs}}",
              "1"
            ]
          },
          "say": "วันที่ทดสอบอยู่คนละเดือนกับเดือนปัจจุบัน กดปุ่ม \"เดือนก่อน\" เพื่อไปเดือนนั้น",
          "shot": true,
          "crop": "tight"
        },
        {
          "do": "expect",
          "that": [
            {
              "visible": {
                "css": "li.gp-item",
                "has_text": "{{last_weekday|th_short}}"
              }
            },
            {
              "text": "ลา",
              "in": {
                "css": "li.gp-item",
                "has_text": "{{last_weekday|th_short}}"
              }
            }
          ],
          "say": "วันที่ \"{{last_weekday|th_short}}\" ปรากฏในรายการพร้อมสถานะ \"ลา\" ตามที่ครูบันทึก",
          "shot": true,
          "crop": "panel",
          "highlight": {
            "css": "li.gp-item",
            "has_text": "{{last_weekday|th_short}}"
          }
        }
