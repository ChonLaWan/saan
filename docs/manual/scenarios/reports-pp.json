{
  "module": "reports-pp",
  "title": "ปพ. และรายงานผลการเรียน",
  "area": "งานวิชาการและงานนักเรียน",
  "purpose": "ครูผู้สอนพิมพ์แบบบันทึกผลการเรียนรายวิชา (เทียบเท่า ปพ.5) ครูประจำชั้นพิมพ์รายงานผลการเรียนรายบุคคล (เทียบเท่า ปพ.6) และสรุปผลรายห้องของห้องตนเอง บันทึกผลพิเศษ ร (ไม่สมบูรณ์) มผ (ไม่ผ่านเกณฑ์) และ มส (ไม่มีสิทธิ์เข้ารับการประเมิน) ซึ่งไม่นำไปคำนวณเกรดเฉลี่ย เขียนหมายเหตุของครูประจำชั้นในรายงานรายบุคคล และส่งออกข้อมูลเป็นไฟล์ CSV ผู้ดูแลระบบและผู้อำนวยการเห็นทุกรายวิชาและทุกห้อง และตั้งค่ารายงาน (แสดงอันดับ ช่องลงนาม เทมเพลตตามปีการศึกษา) ได้ แบบพิมพ์เป็นแบบเทียบเท่าของระบบ ไม่ใช่แบบทางการของเขตพื้นที่การศึกษา",
  "roles": [
    "ผู้ดูแลระบบและผู้อำนวยการ (ทุกรายวิชา ทุกห้อง และตั้งค่ารายงาน)",
    "ครูผู้สอน (ปพ.5 และผลพิเศษของรายวิชาที่สอน)",
    "ครูประจำชั้น (ปพ.6 สรุปผล และหมายเหตุของห้องประจำชั้น)"
  ],
  "menu": [
    "เมนูด้านซ้าย \"งานโรงเรียน\" > \"ปพ. และรายงานผลการเรียน\" (/work#reports)"
  ],
  "prerequisites": [
    {
      "module": "assessment",
      "text": "ต้องมีรายวิชาที่เปิดสอนและคะแนนของนักเรียน รายงานจึงมีข้อมูล"
    },
    {
      "module": "academic",
      "text": "ครูประจำชั้นต้องได้รับการกำหนดไว้ในห้อง"
    }
  ],
  "vars": {
    "room": "ม.4/1",
    "remark": "{{marker}} หมายเหตุตัวอย่าง",
    "template_title": "{{marker}} หัวรายงานตัวอย่าง"
  },
  "workflows": [
    {
      "id": "print-pp5",
      "title": "พิมพ์แบบบันทึกผลการเรียนรายวิชา (ปพ.5) และส่งออก CSV",
      "intro": "หน้า \"ปพ. และรายงานผลการเรียน\" แสดงรายวิชาในหัวข้อ \"รายวิชา (ปพ.5)\" ปุ่ม \"พิมพ์ ปพ.5\" เปิดแบบพิมพ์ในแท็บใหม่ ใช้ปุ่มพิมพ์ของเบราว์เซอร์เพื่อพิมพ์หรือบันทึกเป็น PDF ลิงก์ \"CSV\" ส่งออกคะแนนของรายวิชาเป็นไฟล์ที่เปิดด้วย Excel ได้ ครูเห็นเฉพาะรายวิชาที่ตนสอน ผู้ดูแลระบบและผู้อำนวยการเห็นทุกรายวิชา",
      "role": "admin",
      "start": "/work",
      "core": true,
      "steps": [
        {
          "do": "click",
          "target": {
            "role": "link",
            "name": "ปพ. และรายงานผลการเรียน",
            "exact": true,
            "within": {
              "role": "navigation",
              "name": "ระบบงานโรงเรียน"
            }
          },
          "say": "เลือกเมนู \"ปพ. และรายงานผลการเรียน\" ที่แถบเมนูด้านซ้าย",
          "shot": true,
          "crop": "viewport",
          "wait_after": {
            "css": "li.rp-card",
            "first": true
          }
        },
        {
          "do": "expect",
          "that": {
            "visible": {
              "css": "li.rp-card",
              "has_text": "ค31102",
              "first": true
            }
          },
          "say": "หัวข้อ \"รายวิชา (ปพ.5)\" แสดงการ์ดของแต่ละรายวิชา พร้อมลิงก์ \"พิมพ์ ปพ.5\" \"CSV\" และปุ่ม \"ผล ร / มผ / มส\"",
          "shot": true,
          "crop": "panel",
          "highlight": {
            "css": "li.rp-card",
            "has_text": "ค31102",
            "first": true
          }
        },
        {
          "do": "click",
          "target": {
            "role": "link",
            "name": "พิมพ์ ปพ.5",
            "exact": true,
            "within": {
              "css": "li.rp-card",
              "has_text": "ค31102",
              "first": true
            }
          },
          "say": "กดลิงก์ \"พิมพ์ ปพ.5\" ท้ายการ์ดของรายวิชา ระบบเปิดแบบพิมพ์ในแท็บใหม่",
          "shot": true,
          "crop": "viewport",
          "expect_popup": {
            "url_regex": "print/pp/course/\\d+"
          },
          "settle_ms": 800
        },
        {
          "do": "close_tab"
        },
        {
          "do": "click",
          "target": {
            "role": "link",
            "name": "CSV",
            "exact": true,
            "within": {
              "css": "li.rp-card",
              "has_text": "ค31102",
              "first": true
            }
          },
          "say": "กดลิงก์ \"CSV\" ในการ์ดเดียวกัน เบราว์เซอร์บันทึกไฟล์คะแนนของรายวิชา",
          "shot": true,
          "crop": "panel",
          "highlight": {
            "role": "link",
            "name": "CSV",
            "exact": true,
            "within": {
              "css": "li.rp-card",
              "has_text": "ค31102",
              "first": true
            }
          },
          "expect_download": {
            "ext": ".csv",
            "name_regex": "^pp5-course-",
            "min_bytes": 50
          }
        }
      ],
      "expected": "แท็บใหม่แสดงแบบบันทึกผลการเรียนรายวิชาพร้อมรายชื่อและคะแนน และได้ไฟล์ pp5-course-รหัสวิชา.csv",
      "verify": [
        {
          "title": "ไฟล์ที่ดาวน์โหลดเป็น CSV จริง มีหัวตารางภาษาไทย",
          "steps": [
            {
              "do": "click",
              "target": {
                "role": "link",
                "name": "CSV",
                "exact": true,
                "within": {
                  "css": "li.rp-card",
                  "has_text": "ค31102",
                  "first": true
                }
              },
              "expect_download": {
                "kind": "csv",
                "ext": ".csv",
                "min_bytes": 100,
                "contains": "รหัสนักเรียน"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "special-results",
      "title": "บันทึกผลพิเศษ ร / มผ / มส ของนักเรียนในรายวิชา",
      "intro": "ผลพิเศษใช้แทนเกรดของนักเรียนที่เรียนไม่สมบูรณ์ ร คือไม่สมบูรณ์ มผ คือไม่ผ่านเกณฑ์ และ มส คือไม่มีสิทธิ์เข้ารับการประเมิน ผลพิเศษไม่นำไปคำนวณเกรดเฉลี่ย ภาคเรียนที่ผ่านมาต้องระบุเหตุผลเมื่อแก้ ขั้นตอนนี้ตั้งผลพิเศษของนักเรียนคนแรกในรายการ แล้วคืนเป็น \"(ไม่มี)\" เพื่อไม่เปลี่ยนข้อมูลจริง",
      "role": "admin",
      "start": "/work#reports",
      "steps": [
        {
          "do": "wait_for",
          "target": {
            "css": "li.rp-card",
            "first": true
          }
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "ผล ร / มผ / มส",
            "exact": true,
            "within": {
              "css": "li.rp-card",
              "has_text": "ค31102",
              "first": true
            }
          },
          "say": "กดปุ่ม \"ผล ร / มผ / มส\" ในการ์ดของรายวิชา รายชื่อนักเรียนของรายวิชาแสดงใต้รายการ",
          "shot": true,
          "crop": "viewport",
          "wait_after": {
            "css": ".rp-detail li.rp-card[data-student]",
            "first": true
          }
        },
        {
          "do": "select",
          "target": {
            "role": "combobox",
            "name": "ผลพิเศษ",
            "within": {
              "css": ".rp-detail li.rp-card[data-student]",
              "nth": 0
            }
          },
          "label": "ร",
          "say": "เลือก \"ร\" ในช่อง \"ผลพิเศษ\" ของนักเรียนที่ต้องการ",
          "shot": true,
          "crop": "panel",
          "highlight": {
            "css": ".rp-detail li.rp-card[data-student]",
            "nth": 0
          }
        },
        {
          "do": "fill",
          "target": {
            "role": "textbox",
            "name": "หมายเหตุ",
            "within": {
              "css": ".rp-detail li.rp-card[data-student]",
              "nth": 0
            }
          },
          "value": "{{marker}} ข้อมูลสมมติ",
          "say": "พิมพ์หมายเหตุในช่อง \"หมายเหตุ\"",
          "shot": true,
          "crop": "panel",
          "highlight": {
            "css": ".rp-detail li.rp-card[data-student]",
            "nth": 0
          }
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "บันทึก",
            "exact": true,
            "within": {
              "css": ".rp-detail li.rp-card[data-student]",
              "nth": 0
            }
          },
          "say": "กดปุ่ม \"บันทึก\" ท้ายแถวของนักเรียน ระบบแสดงข้อความ \"บันทึกผลพิเศษแล้ว\"",
          "shot": true,
          "crop": "viewport",
          "highlight": {
            "css": ".rp-notice.rp-ok"
          },
          "wait_after": {
            "css": ".rp-notice.rp-ok"
          }
        },
        {
          "do": "expect",
          "that": {
            "text": "บันทึกผลพิเศษแล้ว",
            "in": {
              "css": ".rp-notice.rp-ok"
            }
          }
        }
      ],
      "expected": "ระบบแสดงข้อความ \"บันทึกผลพิเศษแล้ว\" และแถวของนักเรียนแสดงผล ร กับหมายเหตุ",
      "verify": [
        {
          "title": "เปิดผลพิเศษของรายวิชาใหม่ ผล ร และหมายเหตุต้องยังอยู่",
          "steps": [
            {
              "do": "goto",
              "url": "/work#attendance",
              "wait_after": {
                "css": "section.att"
              }
            },
            {
              "do": "goto",
              "url": "/work#reports",
              "wait_after": {
                "css": "li.rp-card",
                "first": true
              }
            },
            {
              "do": "click",
              "target": {
                "role": "button",
                "name": "ผล ร / มผ / มส",
                "exact": true,
                "within": {
                  "css": "li.rp-card",
                  "has_text": "ค31102",
                  "first": true
                }
              },
              "wait_after": {
                "css": ".rp-detail li.rp-card[data-student]",
                "first": true
              }
            },
            {
              "do": "expect",
              "that": [
                {
                  "value": "ร",
                  "of": {
                    "css": ".rp-detail li.rp-card[data-student] select[data-f=code]",
                    "nth": 0
                  }
                },
                {
                  "value": "{{marker}} ข้อมูลสมมติ",
                  "of": {
                    "css": ".rp-detail li.rp-card[data-student] input[data-f=note]",
                    "nth": 0
                  }
                }
              ],
              "say": "เปิดผลพิเศษของรายวิชาเดิมใหม่ นักเรียนคนแรกยังมีผล ร พร้อมหมายเหตุ",
              "shot": true,
              "crop": "panel",
              "highlight": {
                "css": ".rp-detail li.rp-card[data-student]",
                "nth": 0
              }
            }
          ]
        }
      ]
    },
