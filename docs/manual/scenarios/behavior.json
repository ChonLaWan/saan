{
  "module": "behavior",
  "title": "พฤติกรรมนักเรียน (บันทึกคะแนนความดีและความควรปรับปรุง)",
  "area": "งานวิชาการและงานนักเรียน",
  "purpose": "ครูบันทึกคะแนนพฤติกรรมของนักเรียนรายคนหรือหลายคนพร้อมกัน โดยเลือกตามกติกาที่โรงเรียนกำหนดหรือให้คะแนนเอง ระบบเก็บชื่อผู้บันทึกและวันที่ รวมคะแนนความดีและความควรปรับปรุงเป็นรายภาคเรียน ครูดูสรุปรายห้องและประวัติรายบุคคลได้ รายการที่บันทึกผิดยกเลิกได้โดยต้องระบุเหตุผล และระบบยังเก็บประวัติไว้ ผู้อำนวยการและผู้ดูแลระบบดูรายงานทั้งโรงเรียนและแก้กติกาได้ ผู้ปกครองเห็นเฉพาะรายการที่ครูเปิดให้เห็นและกดรับทราบในพอร์ทัลผู้ปกครอง",
  "roles": [
    "ครูประจำชั้นและครูผู้สอน (บันทึกและดูห้องที่ตนมีสิทธิ์)",
    "ผู้อำนวยการและผู้ดูแลระบบ (ดูทุกห้อง รายงานทั้งโรงเรียน และแก้กติกา)",
    "ผู้ปกครอง (ดูและรับทราบรายการที่ครูเปิดให้เห็นในพอร์ทัลผู้ปกครอง)"
  ],
  "menu": [
    "เมนูด้านซ้าย \"งานโรงเรียน\" > \"พฤติกรรมนักเรียน\" (/work#behavior) มีแท็บ \"บันทึกคะแนน\" และ \"สรุปรายห้อง\" ส่วนแท็บ \"รายงานโรงเรียน\" และ \"กติกาและคะแนน\" แสดงเฉพาะผู้อำนวยการและผู้ดูแลระบบ"
  ],
  "prerequisites": [
    {
      "module": "academic",
      "text": "ต้องตั้งค่าภาคเรียนปัจจุบัน ห้องเรียน และมอบหมายครูประจำชั้นหรือครูผู้สอนของห้อง"
    },
    {
      "module": "registry",
      "text": "ต้องมีรายชื่อนักเรียนอยู่ในห้อง"
    },
    {
      "module": "guardian-portal",
      "text": "ผู้ปกครองจะเห็นรายการได้เมื่อมีบัญชีหรือลิงก์ที่ผูกกับนักเรียน และครูติ๊ก \"ให้ผู้ปกครองเห็น\""
    }
  ],
  "vars": {
    "stu": "ชนก ลานข้าวหอม",
    "stu2": "ชนิดา ปลายฟ้าคราม",
    "gstu": "ทอฝัน",
    "rule_label": "{{marker}} ช่วยงานโรงเรียน",
    "note1": "{{marker}} ช่วยจัดห้องเรียน",
    "note_g": "{{marker}} เป็นผู้นำกิจกรรม"
  },
  "workflows": [
    {
      "id": "record-behavior",
      "title": "บันทึกคะแนนพฤติกรรมของนักเรียนหนึ่งคน (ให้คะแนนเอง)",
      "intro": "ใช้เมื่อพฤติกรรมไม่ตรงกับกติกาที่มีอยู่ ครูกรอกคะแนนเองเป็นเลขบวก (ความดี) หรือเลขลบ (ควรปรับปรุง) และต้องเขียนหมายเหตุ เลือกวันที่ได้เฉพาะวันนี้หรือวันที่ผ่านมาแล้ว เมื่อเลือกนักเรียนคนเดียว ช่อง \"ให้ผู้ปกครองเห็น\" จะถูกติ๊กให้โดยอัตโนมัติ",
      "role": "homeroom",
      "start": "/work",
      "core": true,
      "steps": [
        {
          "do": "click",
          "target": {
            "role": "link",
            "name": "พฤติกรรมนักเรียน",
            "exact": true,
            "within": {
              "role": "navigation",
              "name": "ระบบงานโรงเรียน"
            }
          },
          "say": "เลือกเมนู \"พฤติกรรมนักเรียน\" ที่แถบเมนูด้านซ้าย",
          "shot": true,
          "crop": "viewport",
          "wait_after": {
            "css": "ul.bhv-students li",
            "first": true
          }
        },
        {
          "do": "select",
          "target": {
            "label": "ห้องเรียน",
            "within": {
              "css": "section.bhv-page"
            }
          },
          "label": "ม.1/1",
          "say": "ตรวจว่าช่อง \"ห้องเรียน\" เป็นห้องที่ต้องการ ระบบเลือกห้องประจำชั้นของครูให้ก่อน",
          "shot": true,
          "crop": "panel",
          "highlight": {
            "label": "ห้องเรียน",
            "within": {
              "css": "section.bhv-page"
            }
          },
          "wait_after": {
            "role": "checkbox",
            "name": "{{stu}}"
          }
        },
        {
          "do": "check",
          "target": {
            "role": "checkbox",
            "name": "{{stu}}"
          },
          "say": "ติ๊กช่องหน้าชื่อนักเรียนที่ต้องการบันทึก",
          "shot": true,
          "crop": "tight",
          "highlight": {
            "role": "checkbox",
            "name": "{{stu}}"
          }
        },
        {
          "do": "fill",
          "target": {
            "label": "คะแนนเอง (บวกหรือลบ)",
            "within": {
              "css": "section.bhv-page"
            }
          },
          "value": "7",
          "say": "พิมพ์คะแนนในช่อง \"คะแนนเอง (บวกหรือลบ)\" ใช้เลขบวกสำหรับความดี และเลขลบสำหรับสิ่งที่ควรปรับปรุง",
          "shot": true,
          "crop": "tight"
        },
        {
          "do": "fill",
          "target": {
            "attr": {
              "name": "note"
            },
            "within": {
              "css": "section.bhv-page"
            }
          },
          "value": "{{note1}}",
          "say": "พิมพ์เหตุผลในช่อง \"หมายเหตุ\" ช่องนี้จำเป็นเมื่อให้คะแนนเอง",
          "shot": true,
          "crop": "tight"
        },
        {
          "do": "check",
          "target": {
            "role": "checkbox",
            "name": "ให้ผู้ปกครองเห็น"
          },
          "say": "ตรวจว่าช่อง \"ให้ผู้ปกครองเห็น\" มีเครื่องหมายถูก หากไม่ต้องการให้ผู้ปกครองเห็น ให้เอาเครื่องหมายถูกออก",
          "shot": true,
          "crop": "tight"
        },
        {
          "do": "click",
          "target": {
            "role": "button",
            "name": "บันทึกคะแนน",
            "within": {
              "css": "section.bhv-page"
            }
          },
          "say": "กดปุ่ม \"บันทึกคะแนน\" ระบบแสดงข้อความ \"บันทึกแล้ว 1 รายการ\" ที่ด้านบนของฟอร์ม",
          "shot": true,
          "crop": "viewport",
          "highlight": {
            "css": ".bhv-msg .bhv-notice"
          },
          "expect_response": {
            "url_contains": "/api/behavior/records",
            "method": "POST"
          },
          "wait_after": {
            "css": ".bhv-msg .bhv-notice"
          }
        },
        {
          "do": "expect",
          "that": {
            "text": "บันทึกแล้ว 1 รายการ",
            "in": {
              "css": ".bhv-msg"
            }
          }
        }
      ],
      "expected": "ระบบแจ้งว่าบันทึกแล้ว 1 รายการ และคะแนนสุทธิของนักเรียนในรายชื่อเพิ่มขึ้น 7 คะแนน",
      "verify": [
        {
          "title": "เปิดประวัติของนักเรียน รายการที่บันทึกต้องอยู่ในประวัติพร้อมชื่อผู้บันทึก",
          "steps": [
            {
              "do": "reload"
            },
            {
              "do": "click",
              "target": {
                "role": "link",
                "name": "ประวัติ",
                "within": {
                  "css": "ul.bhv-students li",
                  "has_text": "{{stu}}"
                }
              },
              "wait_after": {
                "css": "ol.bhv-timeline"
              }
            },
            {
              "do": "expect",
              "that": [
                {
                  "visible": {
                    "css": "ol.bhv-timeline li",
                    "has_text": "{{note1}}"
                  }
                },
                {
                  "text": "บันทึกโดย",
                  "in": {
                    "css": "ol.bhv-timeline li",
                    "has_text": "{{note1}}"
                  }
                }
              ],
              "say": "เปิดประวัติของนักเรียน รายการใหม่อยู่ในประวัติ พร้อมคะแนน +7 หมายเหตุ และชื่อผู้บันทึก",
              "shot": true,
              "crop": "panel",
              "highlight": {
                "css": "ol.bhv-timeline li",
                "has_text": "{{note1}}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "manage-rules",
