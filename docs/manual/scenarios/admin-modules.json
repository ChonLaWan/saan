   "steps": [
    {
     "do": "wait_for",
     "target": {
      "css": "article.mods-card[data-id=web-social]"
     }
    },
    {
     "do": "click",
     "target": {
      "role": "button",
      "name": "ส่งออกข้อมูล",
      "within": {
       "css": "article.mods-card[data-id=web-social]"
      }
     },
     "crop": "viewport",
     "highlight": {
      "role": "button",
      "name": "ส่งออกข้อมูล",
      "within": {
       "css": "article.mods-card[data-id=web-social]"
      }
     },
     "wait_after": {
      "css": "#mods-dialog[open]"
     },
     "say": "กดปุ่ม \"ส่งออกข้อมูล\" ที่การ์ดของโมดูล (ปุ่มนี้มีเฉพาะโมดูลที่มีข้อมูล) ระบบเปิดกล่องยืนยัน",
     "shot": true
    },
    {
     "do": "fill",
     "target": {
      "label": "รหัสผ่านของคุณ",
      "within": {
       "id": "mods-dialog"
      }
     },
     "value": "{{secret:admin.password}}",
     "secret": true,
     "crop": "panel",
     "say": "พิมพ์รหัสผ่านของผู้ดูแลระบบในช่อง \"รหัสผ่านของคุณ\" (ภาพนี้ปิดรหัสผ่านไว้)",
     "shot": true
