# Web installer: do NOT copy this to .env; open /install/ after the files are in place.
# Manual installation only: copy this file, configure a NEW empty MariaDB/MySQL database (the only databases Saan supports), generate APP_KEY.
APP_NAME="Saan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://school.example
# Installation role: combined (default, one install serves everything), internal (staff back office, guardian portal, API; no public site) or public (read-only public site only).
# Two editions on one host must not share storage/ or bootstrap/cache, and SESSION_DOMAIN must stay empty (host-only cookies).
SAAN_EDITION=combined
# S7: written by the installer (6 characters a-z 2-7). Never reuse an id on another install on the same machine.
SAAN_INSTALL_ID=
# Optional table prefix, empty by default (docs/split-advanced.th.md)
DB_PREFIX=
# Public edition: the internal edition's URL for the footer link (empty = hidden). Internal edition: the public site's URL for 'view site' links.
SAAN_INTERNAL_URL=
SAAN_PUBLIC_URL=
# Internal edition: the public edition's push endpoint (https://www.school.ac.th/_saan/push). Empty = no push. Keys live in storage/app/private/saan-keys (push.secret/push.pub internal, peer-push.pub public).
SAAN_PUBLIC_PUSH_URL=
APP_LOCALE=th
APP_FALLBACK_LOCALE=en
# The time zone is fixed to Asia/Bangkok in config/app.php; there is no APP_TIMEZONE setting.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
# MariaDB 10.6+ or MySQL 8.0+ only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saan
DB_USERNAME=saan
DB_PASSWORD="CHANGE_ME_DATABASE_PASSWORD"
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# The installer writes a unique cookie name; leave this out unless you need to set one (the edition suffix is added automatically).
# SESSION_COOKIE=saan-session
SESSION_PATH=/
CACHE_STORE=file
# No queue worker is needed: nothing in Saan uses queued jobs, and the installer writes sync.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@school.example
# Server-managed SMTP (choose "server configuration" in /cms#mail). Example with values: config/examples/mail.env.example
# MAIL_HOST=smtp.example.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
SCHOOL_LOCAL_ONLY=false
SCHOOL_DEMO=false
# Behind Cloudflare or a TLS-terminating proxy: comma list of proxy IPs/CIDRs (empty = trust none). Needed for the real client IP and https URLs.
TRUSTED_PROXIES=
SCHOOL_ID=1
SCHOOL_TERM_ID=1

# Scheduled backup (internal and combined editions; needs the cron line of the manual). HH:MM server time, empty = off. Files: storage/app/private/backups/auto-YYYYMMDD.zip
# Each archive holds the database and the private media of the school: mind the disk space (keep x size) and download copies off the server.
# SAAN_BACKUP_DAILY_AT=02:30
# SAAN_BACKUP_KEEP=7

# Media library: total quota per school in MB (0 = unlimited) and the largest single upload in MB. Keep it within PHP upload_max_filesize.
# SAAN_STORAGE_QUOTA_MB=4096
# SAAN_MAX_UPLOAD_MB=10

# Modules (module ids separated by commas): enable = switch on experimental modules, disable = switch off modules. The page /admin/modules shows the state.
# SAAN_ENABLE_MODULES=
# SAAN_DISABLE_MODULES=

# Keys for keyed hashes (PINs, national-id hashes, survey respondents). Empty = APP_KEY is used. It travels with a backup like APP_KEY: never change them on a live install.
# SAAN_HASH_KEY=
# Public edition only: key of the unlock-code hashes exported from the internal edition (see config/saan.php). Never put SAAN_HASH_KEY or APP_KEY on the public side.
# SAAN_PUBLIC_UNLOCK_KEY=

# Updates: SAAN_UPDATE_FEED = address of the signed "new version" feed (checked only when an admin chooses a mode other than off on /admin/updates; the same address folder serves the packages that page downloads).
# SAAN_UPDATE_FINISH = how the steps after a file swap run: auto (default), process, http or inline. SAAN_PHP_CLI = full path of the PHP CLI binary when the web updater cannot find it.
# SAAN_UPDATE_FEED=https://saan.linuxthai.org/releases/feed.json
# SAAN_UPDATE_FINISH=auto
# SAAN_PHP_CLI=

# Complaints form (F1): optional Cloudflare Turnstile, used by the public complaint form only. Empty = off.
SAAN_TURNSTILE_SITE_KEY=
SAAN_TURNSTILE_SECRET=
